{
  "name": "leonardo-brasil",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Marca pessoal Leonardo Brasil — estrutura de vendas para negócios locais. Projeto independente (leonardobrasil.com.br).",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs && node scripts/generate-sitemap.mjs && node scripts/sync-brasa-subdomain.mjs",
    "postinstall": "npm run build",
    "start": "node app.js",
    "test": "node --test server/*.test.mjs",
    "verify": "npm run typecheck && npm run build && npm test",
    "verify:porto-alegre": "node scripts/verify-porto-alegre-digital.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.3",
    "express": "^5.2.1",
    "lucide-react": "^1.70.0",
    "postcss": "^8.5.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.1",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.5"
  }
}
